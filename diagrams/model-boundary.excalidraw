      "index": "aJ",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Rule 3, from Bob's own promises: while Bob is working\nand Alice's job is unfinished, a used card leads to\nat least one more check",
      "roughness": 1,
      "roundness": null,
      "seed": 1885904911,
      "strokeColor": "#ad1457",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "Rule 3, from Bob's own promises: while Bob is working\nand Alice's job is unfinished, a used card leads to\nat least one more check",
