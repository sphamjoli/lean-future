      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Rule 1, from the\nmemory rules:\nonly Bob touches Alice\nwhile checking, and\nshe is not moved",
      "roughness": 1,
      "roundness": null,
      "seed": 969438497,
      "strokeColor": "#1565c0",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "Rule 1, from the\nmemory rules:\nonly Bob touches Alice\nwhile checking, and\nshe is not moved",
