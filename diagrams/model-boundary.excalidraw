    {
      "id": "note",
      "type": "text",
      "x": 40,
      "y": 700,
      "width": 1100,
      "height": 75,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 1,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "aE",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Arrows point inward: each outside party supplies something the model takes as given (Rules 1 to 3, and Charlie's facts).\nNever causing harm is owed whenever Rule 1 holds; the other two promises are owed when all of them hold.\nA proof shows they can all hold at once, so they never contradict each other.",
      "roughness": 1,
      "roundness": null,
      "seed": 175593967,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Arrows point inward: each outside party supplies something the model takes as given (Rules 1 to 3, and Charlie's facts).\nNever causing harm is owed whenever Rule 1 holds; the other two promises are owed when all of them hold.\nA proof shows they can all hold at once, so they never contradict each other.",
      "textAlign": "left",
      "updated": 1795567695822,
      "version": 1,
      "versionNonce": 1003952697,
      "verticalAlign": "top"
    },
    {
